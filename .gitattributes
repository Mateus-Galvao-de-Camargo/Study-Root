# Normaliza line endings de arquivos de texto. Pode ser sobrescrito por linha.
* text=auto eol=lf

# Shell scripts e Dockerfile DEVEM usar LF — CRLF quebra o interpretador no Linux.
*.sh             text eol=lf
Dockerfile       text eol=lf
Dockerfile.*     text eol=lf
*.dockerfile     text eol=lf

# Scripts Windows mantêm CRLF
*.cmd            text eol=crlf
*.bat            text eol=crlf

# Source code em LF
*.php            text eol=lf
*.yml            text eol=lf
*.yaml           text eol=lf
*.sql            text eol=lf
*.json           text eol=lf
*.html           text eol=lf
*.css            text eol=lf
*.js             text eol=lf
*.md             text eol=lf
*.ini            text eol=lf
*.xml            text eol=lf

# Arquivos binários: nunca tocar
*.png            binary
*.jpg            binary
*.jpeg           binary
*.gif            binary
*.ico            binary
*.woff           binary
*.woff2          binary
*.ttf            binary
*.eot            binary
*.otf            binary
*.pdf            binary
