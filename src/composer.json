{
    "name": "study-root/app",
    "description": "Sistema gerenciador de anotações - portfolio",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ezyang/htmlpurifier": "^4.17",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "files": [
            "back-end/lib/db.php",
            "back-end/lib/auth.php",
            "back-end/lib/helpers.php",
            "back-end/lib/html.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "StudyRoot\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit --testdox"
    }
}
