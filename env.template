# =============================================================================
# Study Root — template de variáveis de ambiente.
# Copie para `.env` e ajuste. O .env NÃO é commitado (veja .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# Opção A (recomendada, produção): conexão única via URL.
# Funciona com Neon, Render Postgres, Railway, Supabase, Postgres local etc.
# -----------------------------------------------------------------------------
# DATABASE_URL=postgres://usuario:senha@host:5432/nome_do_banco?sslmode=require

# -----------------------------------------------------------------------------
# Opção B (desenvolvimento local com docker-compose): variáveis discretas.
# -----------------------------------------------------------------------------
DB_DRIVER=pgsql
DB_HOST=db
DB_PORT=5432
DB_NAME=study_root
DB_USER=study_root
DB_PASS=dev_password_change_me

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
APP_ENV=development
# PORT só importa em hosts que exigem porta dinâmica (Render). Default 8080.
PORT=8080
